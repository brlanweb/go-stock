# ===== go-stock 环境变量模板 =====
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除

# HTTP 服务
GOSTOCK_ADDR=:8480

# MySQL
GOSTOCK_DB_HOST=127.0.0.1
GOSTOCK_DB_PORT=3306
GOSTOCK_DB_NAME=stock
GOSTOCK_DB_USER=stock
GOSTOCK_DB_PASSWORD=changeme

# MCP 鉴权（留空表示不鉴权；公网部署强烈建议设置）
GOSTOCK_MCP_TOKEN=

# 页面访问密码（留空表示不启用；设置后访问页面与查询接口需先输入密码，MCP 仍用上面的 Token）
GOSTOCK_ACCESS_PASSWORD=

# 回填并发与限流（建议服务器使用 1 worker / 0.35 QPS，降低固定出口 IP 被限流概率）
GOSTOCK_BACKFILL_WORKERS=1
GOSTOCK_BACKFILL_QPS=0.35
# 设为 false 可在维护或本地验收时禁止启动自动回填
GOSTOCK_AUTO_BACKFILL=true
# 启动历史回填时是否同时刷新行业/概念成分；历史补数专用进程建议关闭
GOSTOCK_SYNC_SECTORS=false
# 盘前是否按推荐自动建立持仓生命周期。默认 false：回测显示候选排序层在
# 2026-03~08 窗口前向收益为负，在证明正期望前推荐只作观察，开仓由人工决策。
GOSTOCK_AUTO_ENTRY=false
GOSTOCK_PYTHON_COMMAND=python3
GOSTOCK_PYTHON_KLINE_SCRIPT=python-provider/fetch_kline.py

# 实时行情缓存 TTL（秒，交易时段）
GOSTOCK_QUOTE_TTL=3
# 自选股实时行情后台同步周期（秒）
GOSTOCK_WATCHLIST_SYNC_SECONDS=5

# Redis 查询缓存（留空表示关闭；Compose 部署使用 redis:6379）
GOSTOCK_REDIS_ADDR=redis:6379
GOSTOCK_REDIS_PASSWORD=
GOSTOCK_REDIS_DB=0
GOSTOCK_REDIS_TTL_SECONDS=60

# AI 推荐（OpenAI 兼容接口；留空表示关闭推荐任务）
GOSTOCK_AI_BASE_URL=
GOSTOCK_AI_API_KEY=
GOSTOCK_AI_MODEL=
# AI 提示词：长提示词放在文件中，此处只填路径（优先级高于 GOSTOCK_AI_PROMPT）
GOSTOCK_AI_PROMPT_FILE=config/ai_prompt.md
# 可选：短提示词直接内联；留空则使用 GOSTOCK_AI_PROMPT_FILE
GOSTOCK_AI_PROMPT=
# 热点漏斗提示词与泛概念黑名单，可按市场口径调整
GOSTOCK_AI_HOTSPOT_PROMPT_FILE=config/hotspot_prompt.md
GOSTOCK_AI_HOTSPOT_PROMPT=
# 每日 17:00 收盘复盘提示词；优化指令自动注入次日趋势推荐
GOSTOCK_AI_REVIEW_PROMPT_FILE=config/review_prompt.md
GOSTOCK_AI_REVIEW_PROMPT=
GOSTOCK_HOTSPOT_BLACKLIST_FILE=config/hotspot_blacklist.txt

# 日志级别 debug/info/warn/error
GOSTOCK_LOG_LEVEL=info
