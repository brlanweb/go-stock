# ===== go-stock 环境变量模板 =====
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除

# HTTP 服务
GOSTOCK_ADDR=:8480

# MySQL
GOSTOCK_DB_HOST=127.0.0.1
GOSTOCK_DB_PORT=3306
GOSTOCK_DB_NAME=stock
GOSTOCK_DB_USER=stock
GOSTOCK_DB_PASSWORD=changeme

# MCP 鉴权（留空表示不鉴权；公网部署强烈建议设置）
GOSTOCK_MCP_TOKEN=

# 回填并发与限流（保守默认，防上游封禁）
GOSTOCK_BACKFILL_WORKERS=2
GOSTOCK_BACKFILL_QPS=3

# 实时行情缓存 TTL（秒，交易时段）
GOSTOCK_QUOTE_TTL=3

# AI 推荐（OpenAI 兼容接口；留空表示关闭推荐任务）
GOSTOCK_AI_BASE_URL=
GOSTOCK_AI_API_KEY=
GOSTOCK_AI_MODEL=
GOSTOCK_AI_PROMPT=基于候选股最近60个交易日OHLCV，评估未来10个交易日维持上涨趋势的概率，只返回3只并说明原因。

# 日志级别 debug/info/warn/error
GOSTOCK_LOG_LEVEL=info
